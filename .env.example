# Bu dosya sadece ŞABLONdur ve commit edilir. Gerçek değerleri buraya
# YAZMA — kopyala, ".env" olarak kaydet (o dosya .gitignore'da, commit
# edilmez), gerçek değerleri oraya gir.
#
# ÖNEMLİ: GitHub Actions bu .env dosyasını OKUMAZ. Otomatik ajanların
# çalışması için bu üç anahtarı ayrıca her ajan repo'sunda/klasöründe
# GitHub → Settings → Secrets and variables → Actions altına eklemen
# gerekir. Buradaki .env sadece senin yerel referansın/notların içindir.

# https://console.anthropic.com üzerinden alınır
ANTHROPIC_API_KEY=

# @BotFather üzerinden oluşturulan bot token'ı (bkz. TELEGRAM-KURULUM.md)
TELEGRAM_BOT_TOKEN=

# Telegram sohbet/kullanıcı ID'n (bkz. TELEGRAM-KURULUM.md)
TELEGRAM_CHAT_ID=
